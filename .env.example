# Copy to .env.production (build) or .env.development.local (npm start) and fill in.
# In Cloudflare Pages, set these as environment variables instead.
REACT_APP_ENV=production
REACT_APP_API_URL=https://your-api.example.com
REACT_APP_MAPBOX_TOKEN=pk.your-public-mapbox-token
REACT_APP_TURNSTILE_SITE_KEY=your-turnstile-site-key
GENERATE_SOURCEMAP=false
